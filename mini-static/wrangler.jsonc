{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "reservoir-mini-private",
  "account_id": "d5f2efd65cf362c6cb833e38e0292dea",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
