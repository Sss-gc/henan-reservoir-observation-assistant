<view class="page" wx:if="{{selected}}">
  <view class="row hero">
    <view><view class="eyebrow">RESERVOIR FIELD LAB</view><view class="title">星地同步实验助手</view></view>
    <view class="brand-mark">◈</view>
  </view>
  <view class="subtitle">让卫星过境与晴好天气在水库相遇</view>
  <view class="data-banner">{{loading ? '正在同步网站数据…' : '天气与过境同源：中央气象台 · 卫星轨道预测'}}</view>
  <view wx:if="{{syncError || meta.orbitError || meta.weatherError}}" class="preview-banner">{{syncError || meta.orbitError || meta.weatherError}}。下拉页面可重新同步。</view>
  <view wx:if="{{meta.orbitStale || meta.weatherStale}}" class="preview-banner">网站数据尚未全部更新至今日，请核验下方轨道生成时间与天气更新时间。</view>

  <view class="search-box row">
    <text class="search-icon">⌕</text>
    <input value="{{keyword}}" placeholder="搜索水库、城市或编号" placeholder-class="search-placeholder" bindinput="onSearch" bindfocus="openPicker" confirm-type="search" />
    <button class="text-button" size="mini" bindtap="togglePicker">{{pickerOpen ? '收起' : '切换'}}</button>
  </view>
  <view class="picker-panel" wx:if="{{pickerOpen}}">
    <view class="picker-summary muted small">共 {{filteredReservoirs.length}} 座水库</view>
    <scroll-view scroll-y="{{true}}" class="reservoir-list">
      <view wx:for="{{filteredReservoirs}}" wx:key="id" class="reservoir-option row {{selected.id === item.id ? 'selected-option' : ''}}" data-id="{{item.id}}" bindtap="selectReservoir">
        <view><view>{{item.name_cn}}</view><view class="muted small">{{item.city}} · {{item.area_km2}} km²</view></view><text class="accent">{{selected.id === item.id ? '已选' : '›'}}</text>
      </view>
      <view wx:if="{{!filteredReservoirs.length}}" class="empty">没有找到匹配的水库</view>
    </scroll-view>
  </view>

  <view class="card reservoir-card">
    <view class="row"><view><view class="section-note">当前水库 · {{selected.city}}</view><view class="reservoir-name">{{selected.name_cn}}</view></view><view class="area"><text>{{selected.area_km2}}</text><view>参考面积 km²</view></view></view>
    <reservoir-map wx:if="{{!pickerOpen}}" id="reservoir-map" class="reservoir-map" style="display:block;width:100%;height:410rpx;" map-data="{{map}}" bind:select="selectMarker"></reservoir-map>
    <view class="map-footer">
      <text class="map-caption muted small">腾讯地图 · 水面边界轮廓</text>
      <view class="map-actions"><button class="text-button" size="mini" bindtap="overviewMap">全部水库</button><button class="text-button" size="mini" bindtap="fitMap">定位当前</button></view>
    </view>
  </view>

  <view class="card weather-card">
    <view class="row"><view class="section-title">7 天天气</view><text class="pill">中央气象台</text></view>
    <view wx:if="{{weather}}" class="section-note">{{weather.stationName}}站 · 发布 {{weather.publishedAt || '未标注'}}</view>
    <view wx:if="{{weather}}" class="section-note">缓存更新 {{weather.fetchedAt}}{{weather.cacheStatus === 'kv-stale-fallback' ? ' · 上次有效缓存' : ''}}</view>
    <view wx:if="{{!weatherDays.length}}" class="empty">{{loading ? '正在读取网站天气缓存…' : (meta.weatherError || '该水库天气尚未获取，下拉可重试。')}}</view>
    <scroll-view scroll-x="{{true}}" class="weather-strip" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{weatherDays}}" wx:key="date" class="weather-day {{item.sunny ? 'sunny-day' : ''}}">
        <view class="weather-date">{{item.label}}</view><view class="weather-symbol">{{item.symbol}}</view><view class="day-condition">{{item.dayCondition}}</view><view class="muted weather-night">夜间 {{item.nightCondition}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-x="{{true}}" class="chip-strip" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{satellites}}" wx:key="*this" class="chip {{satellite === item ? 'active' : ''}}" data-name="{{item}}" bindtap="selectSatellite">{{item}}</view>
  </scroll-view>

  <view class="card recommendations-card">
    <view class="row"><view class="section-title">晴天实验推荐</view><text class="pill">网站同源</text></view>
    <view class="section-note">白天严格为“晴” · 耀光风险单独提示</view>
    <view wx:for="{{recommendations}}" wx:key="id" class="recommendation" data-id="{{item.id}}" bindtap="openPass">
      <view class="row"><text class="pass-satellite">{{item.satellite}}</text><text class="recommendation-score">{{item.score}}<text class="small"> 分</text></text></view>
      <view class="pass-date">{{item.dateLabel}} <text class="accent">{{item.time}}</text></view>
      <view class="row"><text class="muted small">白天晴 · 完整覆盖</text><text class="small risk-{{item.glint_risk}}">耀光{{item.glintLabel}} {{item.glintAngle}}° ›</text></view>
    </view>
    <view wx:if="{{!recommendations.length}}" class="empty">{{loading ? '正在匹配天气与过境窗口…' : (!weather ? '天气尚未获取，暂不能判断晴天窗口。' : '当前筛选没有符合晴天条件的完整覆盖窗口。')}}</view>
    <button class="primary plan-button" bindtap="openPlan">查看实验方案</button>
  </view>

  <view class="card passes-card">
    <view class="row"><view class="section-title">卫星过境窗口</view><text class="muted small">{{passTotal}} 条</text></view>
    <view class="section-note">轨道日期 {{meta.orbitStartDate || '未获取'}} — {{meta.orbitEndDate || '未获取'}}</view>
    <view class="section-note">生成时间 {{meta.orbitGeneratedAt || '未获取'}}</view>
    <view class="status-filters">
      <view wx:for="{{['全部', '仅晴天', '待预报']}}" wx:key="*this" class="status-filter {{passFilter === item ? 'active' : ''}}" data-name="{{item}}" bindtap="selectPassFilter">{{item}}</view>
    </view>
    <view wx:for="{{passes}}" wx:key="id" class="pass-row" data-id="{{item.id}}" bindtap="openPass">
      <view class="row"><text class="pass-satellite">{{item.satellite}}</text><text class="small level-{{item.levelTone}}">{{item.level}} ›</text></view>
      <view class="row pass-date"><text>{{item.dateLabel}} {{item.time}}</text><text class="small risk-{{item.glint_risk}}">耀光{{item.glintLabel}}</text></view>
      <view class="muted small">{{item.sensor}} · {{item.resolution_m}} m · 完整覆盖</view>
    </view>
    <view wx:if="{{!passes.length}}" class="empty">{{loading ? '正在读取网站轨道数据…' : (meta.orbitError || '当前筛选下没有窗口')}}</view>
    <button wx:if="{{passTotal > passes.length}}" class="secondary load-more" bindtap="loadMore">继续查看（{{passes.length}} / {{passTotal}}）</button>
  </view>
  <view class="footnote">过境日期与时刻为北京时间。窗口表示几何覆盖，不代表已安排成像；HJ-2B 为四台 CCD 相机的拼接覆盖。天气与轨道读取现有网站同一份数据，请核验来源更新时间。</view>
</view>
