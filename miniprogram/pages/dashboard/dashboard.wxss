.hero { align-items: flex-start; }
.hero .title { margin-top: 10rpx; font-size: 39rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 80rpx; width: 80rpx; height: 80rpx; border-radius: 23rpx; background: #103d43; margin-left: 12rpx; }
