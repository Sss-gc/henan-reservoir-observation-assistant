.search-box { padding: 13rpx 20rpx; border: 1rpx solid #234353; background: #0b2330; border-radius: 18rpx; }
.search-icon { font-size: 40rpx; color: #6f99ac; margin-right: 14rpx; }
.search-box input { flex: 1; min-width: 0; height: 60rpx; font-size: 26rpx; }
.search-placeholder { color: #6f93a6; }
.picker-panel { margin-top: 12rpx; border: 1rpx solid #254859; background: #0b2330; border-radius: 18rpx; overflow: hidden; }
.picker-summary { padding: 14rpx 24rpx; }
.reservoir-list { max-height: 550rpx; height: 460rpx; }
.reservoir-option { padding: 18rpx 24rpx; border-top: 1rpx solid #1c3949; }
.selected-option { background: #10383d; }
.reservoir-card { padding: 24rpx 24rpx 8rpx; }
.reservoir-name { font-size: 42rpx; font-weight: 650; }
.area { text-align: right; color: #88a6b5; font-size: 20rpx; }
.area > text { color: #d8eef4; font-size: 35rpx; font-weight: 600; }
.reservoir-map { display: block; position: relative; width: 100%; height: 410rpx; margin-top: 22rpx; border-radius: 18rpx; overflow: hidden; background: #dce7e9; }
.native-map { display: block; width: 100%; height: 410rpx; }
.data-banner { margin: 28rpx 0; padding: 20rpx 24rpx; border: 1rpx solid #24615e; border-radius: 16rpx; background: #0d3039; color: #99e8dc; font-size: 23rpx; }
.map-footer { padding-top: 14rpx; }
.map-caption { display: block; }
.map-actions { display: flex; align-items: center; justify-content: flex-end; padding: 4rpx 0; }
.map-actions .text-button + .text-button { margin-left: 24rpx; }
.map-actions .map-zoom-button { width: 40rpx; padding: 10rpx 0; font-size: 32rpx; }
.weather-strip { white-space: nowrap; margin-top: 24rpx; width: 100%; }
.weather-source-link { display: inline-block; padding: 8rpx 0; color: #5eead4; text-decoration: underline; }
.weather-day { display: inline-block; width: 138rpx; padding: 20rpx 10rpx; margin-right: 12rpx; border-radius: 16rpx; background: #102c3a; text-align: center; border: 1rpx solid #234353; }
.weather-day.sunny-day { border-color: #54603b; background: #263025; }
.weather-date { color: #b6cbd5; font-size: 20rpx; }
.weather-symbol { font-size: 51rpx; height: 78rpx; line-height: 78rpx; color: #f2ca67; }
.day-condition { font-size: 26rpx; }
.weather-night { margin-top: 5rpx; font-size: 20rpx; }
.recommendations-card { margin-top: 0; border-color: #24615e; }
.recommendation { margin-top: 24rpx; padding: 22rpx; border-radius: 16rpx; background: #0d3039; border: 1rpx solid #21525b; }
.pass-satellite { font-size: 27rpx; font-weight: 600; }
.recommendation-score { color: #5eead4; font-size: 39rpx; font-weight: 700; }
.pass-date { margin: 8rpx 0; color: #adc8d6; font-size: 24rpx; }
.plan-button { margin-top: 24rpx; }
.status-filters { display: flex; margin: 24rpx 0 8rpx; padding: 6rpx; border-radius: 14rpx; background: #071b26; }
.status-filter { flex: 1; text-align: center; padding: 13rpx 4rpx; color: #88a6b5; font-size: 24rpx; border-radius: 10rpx; }
.status-filter.active { background: #153b47; color: #5eead4; }
.pass-row { padding: 25rpx 0; border-bottom: 1rpx solid #203b4a; }
.load-more { margin-top: 22rpx; }
