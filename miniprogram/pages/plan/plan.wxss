.plan-title { margin-top: 14rpx; font-size: 42rpx; }
.scope-switch { display: flex; padding: 7rpx; border-radius: 17rpx; background: #0a2230; border: 1rpx solid #234353; }
.scope { width: 50%; padding: 19rpx 4rpx; text-align: center; color: #88a6b5; font-size: 26rpx; border-radius: 12rpx; }
.scope.active { background: #153f49; color: #5eead4; }
.summary-card { border-color: #24615e; }
.summary-metrics { display: flex; justify-content: space-around; text-align: center; padding: 28rpx 0; color: #88a6b5; font-size: 22rpx; }
.summary-metrics text { font-size: 54rpx; color: #e6f1f6; font-weight: 600; }
.copy-note { margin-top: 16rpx; text-align: center; }
.plan-record { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #203b4a; }
.record-name { font-size: 27rpx; font-weight: 600; }
.record-satellite { margin: 5rpx 0 10rpx; font-size: 24rpx; color: #c0d7e2; }
.back-button { margin-top: 28rpx; }
