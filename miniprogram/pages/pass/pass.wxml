<view class="page">
  <view wx:if="{{meta.orbitStale || meta.weatherStale}}" class="preview-banner">云端数据尚未全部更新至今日，请核验来源时间。</view>
  <block wx:if="{{pass}}">
    <view class="eyebrow">SATELLITE OVERPASS</view>
    <view class="title detail-title">{{pass.satellite}}</view>
    <view class="subtitle">{{pass.reservoirName}} · {{pass.sensor}}</view>
    <view class="card time-card">
      <view class="overpass-date-row"><text class="overpass-date">{{pass.fullDateLabel}}</text><text class="overpass-weekday">{{pass.weekdayLabel}}</text></view>
      <view class="overpass-time-row"><text class="overpass-time">{{pass.time}}</text><text class="overpass-time-label">北京时间</text></view>
      <view class="row"><text class="pill">完整覆盖 {{pass.coverage}}%</text><text class="pill slate">{{pass.resolution_m}} m 分辨率</text></view>
    </view>
    <view class="card">
      <view class="row"><text class="section-title">实验条件</text><text class="level-{{pass.levelTone}}">{{pass.level}}</text></view>
      <view class="metric row"><text class="muted">白天天气</text><text>{{pass.weatherLabel}}</text></view>
      <view class="metric row"><text class="muted">综合评分</text><text>{{pass.score}}</text></view>
      <view wx:for="{{pass.reasons}}" wx:key="*this" class="reason">{{item}}</view>
    </view>
    <view class="card">
      <view class="row"><text class="section-title">太阳耀光</text><text class="pill risk-{{pass.glint_risk}}">{{pass.glintLabel}}风险</text></view>
      <view class="glint-value risk-{{pass.glint_risk}}">{{pass.glintAngle}}<text>°</text></view>
      <view class="section-note">镜面反射方向与卫星视线的夹角</view>
      <view class="divider"></view>
      <view class="metric row"><text class="muted">太阳高度角</text><text>{{pass.solar_elevation_deg}}°</text></view>
      <view class="metric row"><text class="muted">太阳方位角</text><text>{{pass.solar_azimuth_deg}}°</text></view>
      <view class="metric row"><text class="muted">卫星高度角</text><text>{{pass.satellite_elevation_deg}}°</text></view>
      <view class="metric row"><text class="muted">卫星方位角</text><text>{{pass.satellite_azimuth_deg}}°</text></view>
    </view>
    <view class="card small">
      <view class="section-title">数据来源</view>
      <view class="source-line muted">轨道生成时间：{{meta.orbitGeneratedAt}}</view>
      <view class="source-line muted">轨道历元：{{pass.element_epoch}}</view>
      <view class="source-line muted">幅宽：{{pass.swath_km}} km</view>
      <view class="source-line muted">天气：中央气象台 · {{weather.stationName || '未获取'}}站</view>
      <view class="source-line muted">天气更新时间：{{weather.fetchedAt || '未获取'}}</view>
    </view>
    <view class="actions"><button class="primary" bindtap="copyWindow">复制窗口信息</button><button class="secondary" bindtap="openPlan">查看实验方案</button></view>
    <view class="footnote">过境表示几何覆盖，不代表实际成像任务。耀光分级基于平静水平水面的几何估计，真实水面状态会影响观测。HJ-2B 为四台 CCD 相机的拼接覆盖。</view>
  </block>
  <view wx:else="{{true}}" class="card empty">{{error || meta.orbitError || (notFound ? '没有找到这个窗口，请返回水库观测重新选择。' : '正在读取过境窗口…')}}</view>
</view>
