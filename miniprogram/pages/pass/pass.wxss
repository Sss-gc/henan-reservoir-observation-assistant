.detail-title { margin-top: 14rpx; }
.time-card { border-color: #496b75; }
.overpass-date-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 18rpx; }
.overpass-date { color: #eceff4; font-size: 43rpx; font-weight: 650; line-height: 1.45; }
.overpass-weekday { color: #a7bac6; font-size: 23rpx; }
.overpass-time-row { display: flex; align-items: baseline; margin: 8rpx 0 22rpx; }
.overpass-time { color: #c4d0da; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.overpass-time-label { margin-left: 12rpx; color: #829aa9; font-size: 21rpx; }
.metric { margin-top: 20rpx; font-size: 26rpx; }
.reason { margin-top: 20rpx; padding: 18rpx; background: #162f3b; border-radius: 12rpx; font-size: 24rpx; color: #c8d5de; }
.glint-value { margin-top: 18rpx; font-size: 78rpx; line-height: 1.3; }
.glint-value > text { font-size: 38rpx; }
.source-line { margin-top: 14rpx; word-break: break-all; }
.actions { margin-top: 28rpx; }
.actions button + button { margin-top: 18rpx; }
