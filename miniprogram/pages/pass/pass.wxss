.detail-title { margin-top: 14rpx; }
.time-card { border-color: #24615e; }
.overpass-time { font-size: 92rpx; color: #5eead4; font-weight: 650; line-height: 1.5; }
.overpass-time > text { margin-left: 20rpx; font-size: 23rpx; color: #88a6b5; font-weight: 400; }
.metric { margin-top: 20rpx; font-size: 26rpx; }
.reason { margin-top: 20rpx; padding: 18rpx; background: #102e3b; border-radius: 12rpx; font-size: 24rpx; color: #c2d8e3; }
.glint-value { margin-top: 18rpx; font-size: 78rpx; line-height: 1.3; }
.glint-value > text { font-size: 38rpx; }
.source-line { margin-top: 14rpx; word-break: break-all; }
.actions { margin-top: 28rpx; }
.actions button + button { margin-top: 18rpx; }
