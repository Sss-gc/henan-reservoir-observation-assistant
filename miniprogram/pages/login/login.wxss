.login-page { padding-top: 110rpx; }
.login-page .title { margin-top: 18rpx; font-size: 40rpx; }
.field-label { margin: 30rpx 0 10rpx; color: #b4c5d0; font-size: 24rpx; }
.login-input { padding: 18rpx 20rpx; height: 90rpx; border-radius: 12rpx; background: #0a1c26; border: 1rpx solid #314c5b; }
.primary { margin-top: 34rpx; width: 100%; }
.login-error { margin-top: 24rpx; color: #d9828a; font-size: 24rpx; word-break: break-all; }
