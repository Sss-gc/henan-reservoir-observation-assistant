:host { display: block; width: 100%; }
.map-shell { position: relative; width: 100%; height: 410rpx; overflow: hidden; border-radius: 12px; background: #dce7e9; }
.tiles, .boundary-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tiles { pointer-events: none; }
.tile { position: absolute; width: 256px; height: 256px; }
.boundary-canvas { z-index: 2; }
.zoom-controls { position: absolute; top: 10px; right: 10px; z-index: 3; }
.zoom-button { display: block; width: 32px; height: 32px; margin: 0 0 3px; padding: 0; border-radius: 5px; line-height: 32px; font-size: 23px; color: #17434c; background: #fff; }
.map-status { margin-bottom: 16rpx; padding: 16rpx; border-radius: 10rpx; color: #324c54; background: #f4fafb; font-size: 23rpx; line-height: 1.6; word-break: break-all; }
.status-actions { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.status-button { margin: 0 0 0 16rpx; padding: 0 18rpx; color: #17434c; background: #dce7e9; font-size: 23rpx; }
.attribution { position: absolute; left: 0; bottom: 0; z-index: 3; padding: 1px 6px; font-size: 10px; line-height: 17px; color: #24434a; background: rgba(255,255,255,.95); }
