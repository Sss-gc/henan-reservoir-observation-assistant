:host { display: block; width: 100%; height: 410rpx; }
.map-shell { position: relative; width: 100%; height: 410rpx; overflow: hidden; border-radius: 12px; background: #dce7e9; }
.native-map { display: block; width: 100%; height: 410rpx; border-radius: 12px; }
.zoom-controls { position: absolute; top: 10px; right: 10px; }
.zoom-button { width: 32px; height: 32px; margin-bottom: 3px; border-radius: 5px; line-height: 32px; text-align: center; font-size: 23px; color: #17434c; background: #fff; }
