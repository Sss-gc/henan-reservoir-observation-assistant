{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "henan-reservoir-weather-refresh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "WEATHER_KV",
      "id": "f4853161fcb74d1d82d78fdac748cee7",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
