{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s [%(name)s] %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s %(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "application_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "backend/data/logs/backend.log",
      "maxBytes": 10485760,
      "backupCount": 10,
      "encoding": "utf-8"
    },
    "access_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "backend/data/logs/access.log",
      "maxBytes": 10485760,
      "backupCount": 10,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["application_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["application_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["access_file"],
      "level": "INFO",
      "propagate": false
    },
    "apscheduler": {
      "handlers": ["application_file"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["application_file"],
    "level": "INFO"
  }
}
