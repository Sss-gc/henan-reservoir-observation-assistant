{
  "name": "henan-reservoir-observer",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "validate:static": "python scripts/validate_static_observations.py",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare:data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-data.ps1"
  },
  "dependencies": {
    "@vueuse/core": "^13.6.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
